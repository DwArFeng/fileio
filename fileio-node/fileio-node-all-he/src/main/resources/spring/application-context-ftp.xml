<?xml version="1.0" encoding="UTF-8"?>
<beans
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:ftp="http://dwarfeng.com/schema/dwarfeng-ftp"
        xmlns="http://www.springframework.org/schema/beans"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://dwarfeng.com/schema/dwarfeng-ftp
        http://dwarfeng.com/schema/dwarfeng-ftp/dwarfeng-ftp.xsd"
>

    <ftp:config
            host="${com.dwarfeng.fileio.ftp.host}"
            username="${com.dwarfeng.fileio.ftp.username}"
            password="${com.dwarfeng.fileio.ftp.password}"
            port="${com.dwarfeng.fileio.ftp.port}"
            server-charset="${com.dwarfeng.fileio.ftp.server_charset}"
            connect-timeout="${com.dwarfeng.fileio.ftp.connect_timeout}"
            noop-interval="${com.dwarfeng.fileio.ftp.noop_interval}"
            buffer-size="${com.dwarfeng.fileio.ftp.buffer_size}"
            temporary-file-directory-path="${com.dwarfeng.fileio.ftp.temporary_file_directory_path}"
            temporary-file-prefix="${com.dwarfeng.fileio.ftp.temporary_file_prefix}"
            temporary-file-suffix="${com.dwarfeng.fileio.ftp.temporary_file_suffix}"
            file-copy-memory-buffer-size="${com.dwarfeng.fileio.ftp.file_copy_memory_buffer_size}"
            data-connection-mode="${com.dwarfeng.fileio.ftp.data_connection_mode}"
            data-timeout="${com.dwarfeng.fileio.ftp.data_timeout}"
            active-remote-data-connection-mode-server-host=
                    "${com.dwarfeng.fileio.ftp.active_remote_data_connection_mode_server_host}"
            active-remote-data-connection-mode-server-port=
                    "${com.dwarfeng.fileio.ftp.active_remote_data_connection_mode_server_port}"
    />
    <ftp:handler/>
    <ftp:qos/>
</beans>
