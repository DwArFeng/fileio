<?xml version="1.0" encoding="UTF-8"?>
<beans
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:dubbo="http://dubbo.apache.org/schema/dubbo"
        xmlns="http://www.springframework.org/schema/beans"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://dubbo.apache.org/schema/dubbo
        http://dubbo.apache.org/schema/dubbo/dubbo.xsd"
>

    <!-- region 基础配置 -->

    <dubbo:application name="fileio-node-all-he">
        <dubbo:parameter key="qos.enable" value="false"/>
    </dubbo:application>

    <!-- Zookeeper 注册中心。 -->
    <dubbo:registry
            address="${com.dwarfeng.fileio.dubbo.registry.zookeeper.address}"
            timeout="${com.dwarfeng.fileio.dubbo.registry.zookeeper.timeout}"
    />

    <!-- Dubbo 协议。 -->
    <dubbo:protocol
            name="dubbo"
            port="${com.dwarfeng.fileio.dubbo.protocol.dubbo.port}"
            host="${com.dwarfeng.fileio.dubbo.protocol.dubbo.host}"
            dispatcher="message"
            threadpool="fixed"
            threads="100"
    />
    <!-- Hessian 协议。 -->
    <dubbo:protocol name="hessian" port="${com.dwarfeng.fileio.dubbo.protocol.hessian.port}" server="jetty"/>

    <!-- 默认使用 dubbo 协议。 -->
    <dubbo:provider protocol="dubbo"/>

    <!-- endregion -->

    <!-- region 服务配置 -->

    <!-- region fileio -->

    <!-- 向注册中心注册暴露服务地址，注册服务。 -->
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ExportConfMaintainService"
            ref="exportConfMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ExporterInfoMaintainService"
            ref="exporterInfoMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ExporterSupportMaintainService"
            ref="exporterSupportMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ExportFileInfoMaintainService"
            ref="exportFileInfoMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ExportTaskMaintainService"
            ref="exportTaskMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ExportTaskSettingMaintainService"
            ref="exportTaskSettingMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ExportTemplateInfoMaintainService"
            ref="exportTemplateInfoMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ExportTemplateOperateService"
            ref="exportTemplateOperateServiceImpl"
            protocol="hessian"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ImportConfMaintainService"
            ref="importConfMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ImporterInfoMaintainService"
            ref="importerInfoMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ImporterSupportMaintainService"
            ref="importerSupportMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ImportFileInfoMaintainService"
            ref="importFileInfoMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ImportTaskMaintainService"
            ref="importTaskMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ImportTaskSettingMaintainService"
            ref="importTaskSettingMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ImportTemplateInfoMaintainService"
            ref="importTemplateInfoMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ImportTemplateOperateService"
            ref="importTemplateOperateServiceImpl"
            protocol="hessian"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ReaderInfoMaintainService"
            ref="readerInfoMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ReaderSupportMaintainService"
            ref="readerSupportMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.WriterInfoMaintainService"
            ref="writerInfoMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.WriterSupportMaintainService"
            ref="writerSupportMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ExportMetadataMaintainService"
            ref="exportMetadataMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.ImportMetadataMaintainService"
            ref="importMetadataMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.fileio.stack.service.UserMaintainService"
            ref="userMaintainServiceImpl"
            group="${com.dwarfeng.fileio.dubbo.provider.group}"
    />

    <!-- endregion -->

    <!-- endregion -->

    <!-- region 引用配置 -->

    <!-- region snowflake -->

    <!-- 向注册中心注册暴露服务地址，注册消费者服务。 -->
    <dubbo:reference
            id="snowflakeGenerateService"
            interface="com.dwarfeng.sfds.stack.service.GenerateService"
            check="false"
            group="${com.dwarfeng.fileio.dubbo.consumer.snowflake.group}"
    />

    <!-- endregion -->

    <!-- endregion -->
</beans>
